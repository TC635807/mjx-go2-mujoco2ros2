#
# =============================================================================
# 自包含部署镜像：把「工具链 + 本仓代码」烤进同一个镜像（离线可搬运）
# =============================================================================
#
# 为什么需要有这一层（回答「我们不是有 docker 吗，能不能全打包在一起？」）：
#   docker/Dockerfile 造出来的 unitree-go2-ros2:humble 只装**工具链**
#   （Ubuntu 22.04 + ROS 2 Humble + CycloneDDS 0.10.2 + 官方 unitree_ros2 消息包
#    + 官方 SDK + /opt/venv 的 numpy/mujoco/matplotlib），代码是 run 的时候
#   bind-mount 进去的（compose 里的 GO2_PROJECT:/workspace）。
#   所以那套用法下，宿主机的 .venv / ros2_ws/install 会被容器看见但**不能用**
#   （宿主 py3.13 + x86_64 vs 容器 py3.10），只能靠 GO2_SKIP_PROJECT_WS=1 跳过 ——
#   这就是 portability.md 说「必须重建」的场景。
#
#   本文件把仓库直接 COPY 进镜像：/workspace 里没有宿主的 .venv / install，
#   解释器固定是 /opt/venv（py3.10），unitree_go 固定是镜像里编译好的那份。
#   -> 得到一个**不依赖宿主文件**的单文件交付物：docker save 成 tar，拷过去
#      docker load 就能跑，不需要网络、不需要 pip、不需要 colcon、不需要重建。
#
# 构建（上下文必须是仓库根，因为要 COPY 整个仓）：
#   docker build -f docker/Dockerfile.deploy -t go2-deploy:day0 .
# 或直接用脚本：
#   bash docker/build_deploy_image.sh --build --save
#
# 运行（没有任何 -v 挂载）：
#   docker run --rm -it --network=host \
#       -e UNITREE_NIC=<接狗网卡> -e ROS_DOMAIN_ID=0 go2-deploy:day0 \
#       bash -lc "python3 scripts/env_check.py --target real_ros && bash scripts/real_run.sh --stage preflight"
#
# 注意：代码改动需要重新 build 这一层（COPY 会让上层缓存失效），所以：
#   * 现场迭代代码 -> 用 bind-mount 那套（compose，改文件立刻生效）；
#   * 交付/离线搬运 -> 用这个自包含镜像（一次构建，到处 load）。
# =============================================================================

ARG BASE_IMAGE=unitree-go2-ros2:humble
FROM ${BASE_IMAGE}

# 镜像内用户已是 uid 1000；--chown 保证 /workspace 可写（logs/ 要落盘）
COPY --chown=1000:1000 . /workspace

# logs/ 在 .dockerignore 里被排除了，这里补出来（真机运行/评测都会往里写）
RUN mkdir -p /workspace/logs && chown -R 1000:1000 /workspace/logs

WORKDIR /workspace

# ---------------------------------------------------------------------------
# 中和官方 /opt/unitree_ros2/setup.sh 的硬编码（实测踩过：上机时 source 它会把
# 入口设好的 CYCLONEDDS_URI 覆盖成 enp3s0（官方文档里那台机器的网卡名），于是
#   ros2: enp3s0: does not match an available interface.
#   [ERROR] [rmw_cyclonedds_cpp]: rmw_create_node: failed to create domain
# 而且第一行 source 的是 /opt/ros/foxy/setup.bash（本镜像是 humble）。
# 换成"重新应用正确环境"的版本，这样谁再 source 它都不会把环境搞坏。
USER root
RUN printf %s\\n \
      "#!/bin/bash" \
      "# 由 go2-deploy 镜像替换：官方原版把 foxy 和 enp3s0 写死了。" \
      "# 这里改成重新 source 本镜像的正确环境（尊重 UNITREE_NIC / ROS_DOMAIN_ID）。" \
      "source /opt/setup_unitree_humble.sh" \
      > /opt/unitree_ros2/setup.sh \
 && chmod 0644 /opt/unitree_ros2/setup.sh
USER 1000:1000

# 构建期自检：解释器/依赖/消息包不对就当场失败，别等上机才发现
RUN python3 -c "import numpy, mujoco, rclpy, unitree_go.msg as m; print('deploy image ok:', numpy.__version__, mujoco.__version__, m.LowState.__name__)"

# 基础镜像的 entrypoint（source /opt/setup_unitree_humble.sh）保持不变
CMD ["bash"]
